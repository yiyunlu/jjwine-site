# Cloudflare static asset headers. A public/_headers file replaces the one the
# build would otherwise generate, so the generated /_next/static/* rule is kept here.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font files are never rewritten in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
