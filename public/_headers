# Cloudflare static asset headers. A public/_headers file replaces the one the
# build would otherwise generate, so the generated /_next/static/* rule is kept here.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font files are never rewritten in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for static assets; the worker sets the same ones on its own responses.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
